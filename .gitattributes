# Normalize all text files to LF line endings in the repository, regardless
# of what line endings a contributor's checkout/editor produces. This is
# what keeps GitHub's diff view (and git diff locally) from ever showing a
# file as fully rewritten just because its line-ending convention changed.
* text=auto

# Known binary types: never let Git attempt any text/line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ipynb binary
